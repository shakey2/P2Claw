# ╔══════════════════════════════════════════════════════════════╗
# ║                    P2 Claw Configuration                    ║
# ╚══════════════════════════════════════════════════════════════╝
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ─── Telegram ───────────────────────────────────────────────────
# 1. Open Telegram and message @BotFather
# 2. Send /newbot and follow the prompts
# 3. Copy the bot token and paste below
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram numeric user ID. Only these users can interact
# with the bot. Comma-separated for multiple IDs.
# To find your ID: message @userinfobot on Telegram
TELEGRAM_ALLOWED_USER_IDS=123456789

# ─── Player2 Profiles (Patron Feature) ─────────────────────────
# Set to "true" to enable AI profile switching.
# Each profile bundles an LLM + TTS + image + video model selection.
# Requires an active Player2 Patron subscription.
USE_PROFILES=true

# Default profile name (leave empty to use the Player2 App default).
# Must match a profile name from your Player2 App settings.
DEFAULT_PROFILE=

# ─── Agent Settings ─────────────────────────────────────────────
# Max tool-call iterations per message (safety limit).
MAX_AGENT_ITERATIONS=10

# Default voice output for new chats until overridden with /voice.
# off | tg (Telegram voice note) | pc (Player2 App plays on host speakers)
DEFAULT_VOICE_MODE=off

# System prompt personality name
BOT_NAME=Ellie

# ─── Developer Only (Optional) ─────────────────────────────────
# Override the embedded Player2 Game Key.
# End users do NOT need to set this — the key is built in.
# Only use this if you're developing P2 Claw and want to test
# with a different game key than the one embedded in security.ts.
# PLAYER2_GAME_KEY=
