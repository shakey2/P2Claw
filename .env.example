# ╔══════════════════════════════════════════════════════════════╗
# ║                    P2 Claw Configuration                    ║
# ╚══════════════════════════════════════════════════════════════╝
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ─── Telegram ───────────────────────────────────────────────────
# 1. Open Telegram and message @BotFather
# 2. Send /newbot and follow the prompts
# 3. Copy the bot token and paste below
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram numeric user ID. Only these users can interact
# with the bot. Comma-separated for multiple IDs.
# To find your ID: message @userinfobot on Telegram
TELEGRAM_ALLOWED_USER_IDS=123456789

# ─── Player2 Profiles (Patron Feature) ─────────────────────────
# Set to "true" to enable AI profile switching.
# Each profile bundles an LLM + TTS + image + video model selection.
# Requires an active Player2 Patron subscription.
USE_PROFILES=true

# Default profile name (leave empty to use the Player2 App default).
# Must match a profile name from your Player2 App settings.
DEFAULT_PROFILE=

# ─── Agent Settings ─────────────────────────────────────────────
# Max tool-call iterations per message (safety limit).
MAX_AGENT_ITERATIONS=10

# Default voice output for new chats until overridden with /voice.
# off | tg (Telegram voice note) | pc (Player2 App plays on host speakers)
DEFAULT_VOICE_MODE=off

# Assistant display name in prompt, Telegram, and HTML UI (default: Ellie — Player2 elephant mascot)
BOT_NAME=Ellie

# ─── UI Mode (Frontend) ─────────────────────────────────────────
# Which interface should run:
#   telegram (default) | cli | html
# html = loopback-only web UI at http://127.0.0.1:3847 (see DESIGN.md §2.1.2)
# UI_MODE=telegram

# Bind address for the HTML GUI (loopback only — must stay 127.0.0.1 or ::1)
# HTML_UI_HOST=127.0.0.1

# Port for the HTML GUI (default 3847)
# HTML_UI_PORT=3847

# ─── Shared memory scope (all UIs) ─────────────────────────────
# Integer key used for SQLite memory rows and stored voice preference.
# Telegram chat id and CLI session id do not affect this — same value = same
# memories in Telegram, CLI, and future frontends. Default: 1
# P2CLAW_MEMORY_CHAT_ID=1

# ─── Debug Logging (Developer) ──────────────────────────────────
# If true, prints the raw model response (first 100 chars) to console.
# Default is false (do not log model output by default).
# P2CLAW_LOG_RAW_MODEL=false

# ─── Level 4 — TOTP (high-risk tools) ───────────────────────────
# RFC 6238 secret in Base32 (Google Authenticator, Aegis, etc.).
# Generate a random secret, add the same value to your authenticator app,
# then paste here. Required only if you use high-risk tools.
# TOTP_SECRET_BASE32=

# ─── Developer Only (Optional) ─────────────────────────────────
# Override the embedded Player2 Game Key.
# End users do NOT need to set this — the key is built in.
# Only use this if you're developing P2 Claw and want to test
# with a different game key than the one embedded in security.ts.
# PLAYER2_GAME_KEY=

# ─── Dev mode (Developer diagnostics) ───────────────────────────
# When true, enables the dev-tools module and the /debug slash command
# in every frontend. Leave false for normal installs — this is meant
# for P2 Claw contributors and module authors, not end users.
# See DESIGN.md §4.7.
P2CLAW_DEV_MODE=false
